# Curiosity Engine Configuration
# Copy to .env and customize

# Required paths
CURIOSITY_QUEUE=./data/research_queue.json
CURIOSITY_OUTPUT=./output

# Optional: PostgreSQL for persistent memory storage
# DATABASE_URL=postgresql://user:pass@localhost:5432/research
# Where it reads fragments and writes summaries, and the consciousness_id it writes them under. These were
# hard-coded to lyra_memories / lyra_consciousness; set them to those to keep the old behaviour.
# CURIOSITY_PG_TABLE=memories
# CURIOSITY_PG_NAMESPACE=curiosity_engine

# Optional: Claude CLI for LLM-assisted follow-up generation
# CLAUDE_CLI=claude
# CLAUDE_MODEL=haiku

# Optional: OpenAlex polite pool (faster responses)
# OPENALEX_EMAIL=your@email.com

# Optional: File for manual research ideas
# CURIOSITY_IDEAS=./ideas.md

# Optional: local mode, no Claude CLI and no PostgreSQL (see "Running locally" in README.md).
# The engine does not read this file itself: export these, or source the file.
# CURIOSITY_LLM=ollama
# OLLAMA_URL=http://127.0.0.1:11434
# CURIOSITY_OLLAMA_MODEL=qwen3:4b
# CLAUDE_CLI=/bin/false
# CURIOSITY_MEMORY_DB=/path/to/memory.db
# CURIOSITY_SELF_AGENT_TAG=agent:me
# CURIOSITY_ASKER_FILE=./data/asker.md
# CURIOSITY_PRIVATE_TERMS=./data/private_terms.txt
# CURIOSITY_ITEMS_PER_RUN=2
# S2_API_KEY_FILE=/path/to/s2_api_key
